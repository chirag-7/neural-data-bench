ps. Nights are processed independently, preserving boundaries. Deterministic seeds, single-thread classifiers, and no external assets.\n", "code_lines": 207, "line_limit_exclusive": 240, "line_limit_compliant": true, "seconds": 1.291821249993518, "score": 0.6783412614813794, "metric": "macro_f1_sleep", "direction": "higher", "accuracy": 0.7840277777777778, "balanced_accuracy": 0.7041700506813882, "per_unit": [0.31025137930688496, 0.8087189353051867, 0.7534639886982808], "night_results": [{"group": "5", "score": 0.31025137930688496, "metric": "macro_f1_sleep", "n": 1440}, {"group": "6", "score": 0.8087189353051867, "metric": "macro_f1_sleep", "n": 1440}, {"group": "7", "score": 0.7534639886982808, "metric": "macro_f1_sleep", "n": 1440}], "n_scored_epochs": 4320, "n_units": 3, "scoring_seconds": 1.0523659591563046, "prediction_file": "experiments/generation-repairs-v1/artifacts/H08/gpt-5-2025-08-07/r1/expansion-v1/predictions.npz", "prediction_sha256": "8bdd891e1207d0baccb302269b045f58cdb93657386517fa7a9e5f5c66813a8a", "strict_format_compliant": true, "repair_revision": "r1", "repair_type": "manual_runtime_compatibility_or_shape_patch", "patch_description": "Use NumPy 2-compatible np.ptp; remove removed multi_class keyword where present, retaining multinomial-capable original solver.", "original_key": {"benchmark_id": "H08", "slice_id": "expansion-v1", "model": "gpt-5-2025-08-07"}, "original_code_sha256": "3f6a78531baaf0726b915a8281601cfc37163e43cfdf9a4680a0bedcb6c1d950", "test_labels_used_for_patch": false, "manual_debugging": true}
