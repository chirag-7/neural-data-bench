{"id": "s0vdx-0k302", "created": "2022-09-13T19:19:49.887342+00:00", "updated": "2024-08-16T01:02:14.250039+00:00", "links": {"self": "https://data.caltech.edu/api/records/s0vdx-0k302", "self_html": "https://data.caltech.edu/records/s0vdx-0k302", "preview_html": "https://data.caltech.edu/records/s0vdx-0k302?preview=1", "doi": "https://doi.org/10.22002/D1.1991", "self_doi": "https://doi.org/10.22002/D1.1991", "self_doi_html": "https://data.caltech.edu/doi/10.22002/D1.1991", "reserve_doi": "https://data.caltech.edu/api/records/s0vdx-0k302/draft/pids/doi", "parent": "https://data.caltech.edu/api/records/9xj62-g9x06", "parent_html": "https://data.caltech.edu/records/9xj62-g9x06", "self_iiif_manifest": "https://data.caltech.edu/api/iiif/record:s0vdx-0k302/manifest", "self_iiif_sequence": "https://data.caltech.edu/api/iiif/record:s0vdx-0k302/sequence/default", "files": "https://data.caltech.edu/api/records/s0vdx-0k302/files", "media_files": "https://data.caltech.edu/api/records/s0vdx-0k302/media-files", "latest": "https://data.caltech.edu/api/records/s0vdx-0k302/versions/latest", "latest_html": "https://data.caltech.edu/records/s0vdx-0k302/latest", "versions": "https://data.caltech.edu/api/records/s0vdx-0k302/versions", "draft": "https://data.caltech.edu/api/records/s0vdx-0k302/draft", "access_links": "https://data.caltech.edu/api/records/s0vdx-0k302/access/links", "access_grants": "https://data.caltech.edu/api/records/s0vdx-0k302/access/grants", "access_users": "https://data.caltech.edu/api/records/s0vdx-0k302/access/users", "access_request": "https://data.caltech.edu/api/records/s0vdx-0k302/access/request", "access": "https://data.caltech.edu/api/records/s0vdx-0k302/access", "communities": "https://data.caltech.edu/api/records/s0vdx-0k302/communities", "communities-suggestions": "https://data.caltech.edu/api/records/s0vdx-0k302/communities-suggestions", "requests": "https://data.caltech.edu/api/records/s0vdx-0k302/requests"}, "revision_id": 7, "parent": {"id": "9xj62-g9x06", "access": {"owned_by": {"user": "359"}}, "communities": {}, "pids": {}}, "versions": {"is_latest": true, "index": 1}, "is_published": true, "is_draft": false, "pids": {"doi": {"identifier": "10.22002/D1.1991", "provider": "datacite", "client": "datacite"}, "oai": {"identifier": "oai:data.caltech.edu:s0vdx-0k302", "provider": "oai"}}, "metadata": {"resource_type": {"id": "dataset", "title": {"en": "Dataset"}}, "creators": [{"person_or_org": {"type": "organizational", "name": "Jennifer J. Sun"}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}]}, {"person_or_org": {"type": "organizational", "name": "Tomomi Karigo"}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}]}, {"person_or_org": {"type": "organizational", "name": "David J. Anderson"}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}]}, {"person_or_org": {"type": "organizational", "name": "Pietro Perona"}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}]}, {"person_or_org": {"type": "organizational", "name": "Yisong Yue"}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}]}, {"person_or_org": {"type": "organizational", "name": "Ann Kennedy"}, "affiliations": [{"id": "000e0be47", "name": "Northwestern University", "identifiers": [{"identifier": "000e0be47", "scheme": "ror"}]}]}], "title": "Caltech Mouse Social Interactions (CalMS21) Dataset", "publisher": "CaltechDATA", "publication_date": "2021-06-07", "subjects": [{"subject": "behavior modeling"}, {"subject": "machine learning"}, {"subject": "trajectory data"}, {"subject": "multi-agent behavior"}, {"subject": "mouse"}, {"subject": "social behavior"}, {"subject": "computational ethology"}], "languages": [{"id": "eng", "title": {"en": "English"}}], "identifiers": [{"identifier": "1991", "scheme": "cdid"}], "version": "1.0", "rights": [{"id": "cc-by-4.0", "title": {"en": "Creative Commons Attribution 4.0 International"}, "description": {"en": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited."}, "icon": "cc-by-icon", "props": {"url": "https://creativecommons.org/licenses/by/4.0/legalcode", "scheme": "spdx"}}], "description": "Multi-agent behavior modeling aims to understand the interactions that occur between agents. We present a multi-agent dataset from behavioral neuroscience, the Caltech Mouse Social Interactions (CalMS21) Dataset. Our dataset consists of trajectory data of social interactions, recorded from videos of freely behaving mice in a standard resident-intruder assay. \nTo help accelerate behavioral studies, the CalMS21 dataset provides benchmarks to evaluate the performance of automated behavior classification methods in three settings: (1) for training on large behavioral datasets all annotated by a single annotator, (2) for style transfer to learn inter-annotator differences in behavior definitions, and (3) for learning of new behaviors of interest given limited training data. The dataset consists of 6 million frames of unlabeled tracked poses of interacting mice, as well as over 1 million frames with tracked poses and corresponding frame-level behavior annotations. The challenge of our dataset is to be able to classify behaviors accurately using both labeled and unlabeled tracking data, as well as being able to generalize to new settings.", "additional_descriptions": [{"description": "Our trajectory dataset is available in json format. Please download and unzip the zip files for each task to access the data.  Our video datasets are available as mp4 format (task1_videos_mp4.zip) or seq format (task1_videos_seq.zip). Additionally, we release the pre-computed MARS features on our dataset in task1_MARS_features.zip.\n\nThe readme included for download with the dataset provides a more detailed description of the data format, and a script to read json files and convert them to npy files (Python) is included.\n\n\nSee our website for more info:  https://sites.google.com/view/computational-behavior/our-datasets/calms21-dataset\n\n\nSee our paper for more details on the dataset and benchmarks: https://arxiv.org/abs/2104.02710", "type": {"id": "other", "title": {"de": "Sonstige", "en": "Other"}}}, {"description": "Please cite the following paper if you find the dataset useful: https://arxiv.org/abs/2104.02710\n\n\nBibTeX:\n@article{calms21,\n  title={The Multi-Agent Behavior Dataset: Mouse Dyadic Social Interactions},\n  author={Sun, Jennifer J and Karigo, Tomomi and Chakraborty, Dipam and Mohanty, Sharada P and Wild, Benjamin and Sun, Quan and Chen, Chen and Anderson, David J and Perona, Pietro and Yue, Yisong and Kennedy, Ann},\n  journal={arXiv preprint arXiv:2104.02710},\n  year={2021}\n}", "type": {"id": "other", "title": {"de": "Sonstige", "en": "Other"}}}], "funding": [{"funder": {"id": "01cmst727", "name": "Simons Foundation"}, "award": {"number": "543025", "title": {"en": ":unav"}}}, {"funder": {"id": "01cwqze88", "name": "National Institutes of Health"}, "award": {"number": "K99MH117264", "title": {"en": ":unav"}}}, {"funder": {"id": "021nxhr62", "name": "U.S. National Science Foundation"}, "award": {"number": "IIS-1918839", "title": {"en": ":unav"}}}, {"funder": {"name": "Natural Sciences and Engineering Research Council of Canada"}, "award": {"number": "PGSD3-532647-2019", "title": {"en": ":unav"}}}]}, "custom_fields": {}, "access": {"record": "public", "files": "public", "embargo": {"active": false, "reason": null}, "status": "open"}, "files": {"enabled": true, "order": [], "count": 